import pytest
from fastapi.testclient import TestClient

from app.main import app


@pytest.fixture()
def client():
    with TestClient(app) as c:  # runs startup, which loads the model
        yield c


def test_health_reports_model_version(client):
    res = client.get("/healthz")
    assert res.status_code == 200
    assert res.json()["model_version"] == "example-1"


def test_predict(client):
    res = client.post("/predict", json={"features": [2.0, 1.0, 0.5]})
    assert res.status_code == 200
    # 0.5*2.0 - 1.25*1.0 + 2.0*0.5 + 0.1
    assert res.json()["prediction"] == pytest.approx(0.85)


def test_wrong_feature_count_is_rejected(client):
    res = client.post("/predict", json={"features": [1.0]})
    assert res.status_code == 422


def test_non_numeric_input_is_rejected(client):
    res = client.post("/predict", json={"features": ["a", "b", "c"]})
    assert res.status_code == 422
