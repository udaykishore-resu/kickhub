name: release
on:
  push:
    tags: ["v*.*.*"]

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - run: go test -race ./...
      - name: Create GitHub release
        run: gh release create "$GITHUB_REF_NAME" --generate-notes
        env:
          GH_TOKEN: ${{ github.token }}
      # Asks the Go module proxy to fetch the tag so it shows up on pkg.go.dev.
      - name: Publish to pkg.go.dev
        run: GOPROXY=proxy.golang.org go list -m "[[.P.go_module]]@$GITHUB_REF_NAME"
