variable "vpc_id" {
  type = string
}

variable "subnet_ids" {
  description = "Private subnets in at least two availability zones"
  type        = list(string)
}

variable "allowed_cidrs" {
  description = "Ranges allowed to reach the Gremlin port"
  type        = list(string)
  default     = ["10.0.0.0/8"]
}

variable "deletion_protection" {
  type    = bool
  default = true
}

resource "aws_neptune_subnet_group" "this" {
  name       = var.name
  subnet_ids = var.subnet_ids
}

resource "aws_security_group" "graph" {
  name_prefix = "${var.name}-graph-"
  description = "${var.name}: Neptune"
  vpc_id      = var.vpc_id

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_vpc_security_group_ingress_rule" "gremlin" {
  for_each          = toset(var.allowed_cidrs)
  security_group_id = aws_security_group.graph.id
  cidr_ipv4         = each.value
  from_port         = 8182
  to_port           = 8182
  ip_protocol       = "tcp"
}

resource "aws_neptune_cluster" "this" {
  cluster_identifier                  = var.name
  engine                              = "neptune"
  neptune_subnet_group_name           = aws_neptune_subnet_group.this.name
  vpc_security_group_ids              = [aws_security_group.graph.id]
  storage_encrypted                   = true
  iam_database_authentication_enabled = true
  backup_retention_period             = 7
  deletion_protection                 = var.deletion_protection
  skip_final_snapshot                 = false
  final_snapshot_identifier           = "${var.name}-final"

  serverless_v2_scaling_configuration {
    min_capacity = 1
    max_capacity = 4
  }
}

resource "aws_neptune_cluster_instance" "writer" {
  identifier         = "${var.name}-1"
  cluster_identifier = aws_neptune_cluster.this.id
  instance_class     = "db.serverless"
  engine             = "neptune"
}

output "endpoint" {
  value = aws_neptune_cluster.this.endpoint
}

output "reader_endpoint" {
  value = aws_neptune_cluster.this.reader_endpoint
}
