// Command server runs the API as a plain HTTP server, for local development
// and for any container platform.
package main

import (
	"log/slog"
	"net/http"
	"os"
	"time"

	"[[.P.go_module]]/internal/api"
)

func main() {
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}
	srv := &http.Server{Addr: ":" + port, Handler: api.Handler(), ReadHeaderTimeout: 5 * time.Second}
	slog.Info("[[.Name]] listening", "port", port)
	if err := srv.ListenAndServe(); err != nil {
		slog.Error("server failed", "err", err)
		os.Exit(1)
	}
}
