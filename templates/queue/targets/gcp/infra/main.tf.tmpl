variable "max_deliveries" {
  description = "Delivery attempts before a message moves to the dead-letter topic"
  type        = number
  default     = 5
}

data "google_project" "this" {}

resource "google_project_service" "pubsub" {
  service            = "pubsub.googleapis.com"
  disable_on_destroy = false
}

resource "google_pubsub_topic" "main" {
  name       = var.name
  depends_on = [google_project_service.pubsub]
}

resource "google_pubsub_topic" "dlq" {
  name       = "${var.name}-dlq"
  depends_on = [google_project_service.pubsub]
}

resource "google_pubsub_subscription" "dlq" {
  name                       = "${var.name}-dlq"
  topic                      = google_pubsub_topic.dlq.id
  message_retention_duration = "1209600s"
}

resource "google_pubsub_subscription" "main" {
  name                 = var.name
  topic                = google_pubsub_topic.main.id
  ack_deadline_seconds = 60

  dead_letter_policy {
    dead_letter_topic     = google_pubsub_topic.dlq.id
    max_delivery_attempts = var.max_deliveries
  }
}

# Pub/Sub's own service agent moves messages to the dead-letter topic.
locals {
  pubsub_agent = "serviceAccount:service-${data.google_project.this.number}@gcp-sa-pubsub.iam.gserviceaccount.com"
}

resource "google_pubsub_topic_iam_member" "dlq_publisher" {
  topic  = google_pubsub_topic.dlq.id
  role   = "roles/pubsub.publisher"
  member = local.pubsub_agent
}

resource "google_pubsub_subscription_iam_member" "dlq_forwarder" {
  subscription = google_pubsub_subscription.main.id
  role         = "roles/pubsub.subscriber"
  member       = local.pubsub_agent
}

output "topic" {
  value = google_pubsub_topic.main.id
}

output "subscription" {
  value = google_pubsub_subscription.main.id
}
