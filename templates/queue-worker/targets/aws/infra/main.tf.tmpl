terraform {
  required_version = ">= 1.6"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.region
  default_tags {
    tags = { component = var.name, managed_by = "terraform", created_with = "kickhub" }
  }
}

variable "name" {
  type    = string
  default = "[[.Name]]"
}

variable "region" {
  type    = string
  default = "[[.P.aws_region]]"
}

variable "max_deliveries" {
  type    = number
  default = [[.P.max_deliveries]]
}

resource "aws_sqs_queue" "dlq" {
  name                      = "${var.name}-dlq"
  message_retention_seconds = 1209600 # 14 days to inspect poison messages
  sqs_managed_sse_enabled   = true
}

resource "aws_sqs_queue" "main" {
  name                       = var.name
  visibility_timeout_seconds = 60
  receive_wait_time_seconds  = 20
  sqs_managed_sse_enabled    = true

  redrive_policy = jsonencode({
    deadLetterTargetArn = aws_sqs_queue.dlq.arn
    maxReceiveCount     = var.max_deliveries
  })
}

# Attach this to whatever runs the worker (ECS task role, Lambda role, EKS IRSA role).
resource "aws_iam_policy" "consumer" {
  name = "${var.name}-consumer"
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
      Resource = aws_sqs_queue.main.arn
    }]
  })
}

output "queue_url" {
  value = aws_sqs_queue.main.url
}

output "dlq_url" {
  value = aws_sqs_queue.dlq.url
}

output "consumer_policy_arn" {
  value = aws_iam_policy.consumer.arn
}
