# Fully local stack: no cloud account, no credentials.
# The worker runs the same SQS adapter it uses on AWS, pointed at ElasticMQ.
x-aws-env: &aws-env
  AWS_REGION: [[.P.aws_region]]
  AWS_ACCESS_KEY_ID: local
  AWS_SECRET_ACCESS_KEY: local
  AWS_ENDPOINT_URL: http://elasticmq:9324

services:
  elasticmq:
    image: softwaremill/elasticmq-native:latest
    ports:
      - "9324:9324" # SQS API
      - "9325:9325" # web console

  init:
    image: amazon/aws-cli:latest
    depends_on:
      - elasticmq
    environment: *aws-env
    entrypoint: ["sh", "-c"]
    command:
      - >
        until aws sqs list-queues >/dev/null 2>&1; do sleep 1; done;
        aws sqs create-queue --queue-name [[.Name]]

  worker:
    build: .
    depends_on:
      init:
        condition: service_completed_successfully
    environment:
      <<: *aws-env
      QUEUE_URL: http://elasticmq:9324/000000000000/[[.Name]]

  # One-off helper: `make send MSG=hello`
  send:
    image: amazon/aws-cli:latest
    profiles: ["tools"]
    environment: *aws-env
    entrypoint: ["aws", "sqs", "send-message", "--queue-url", "http://elasticmq:9324/000000000000/[[.Name]]", "--message-body"]
