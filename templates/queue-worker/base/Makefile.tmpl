.PHONY: tidy build test vet[[ if eq .Target "local" ]] up down send logs[[ else ]] infra-init infra-plan infra-apply[[ end ]]

go.sum: go.mod
	go mod tidy

tidy:
	go mod tidy

build: go.sum
	go build ./...

test: go.sum
	go test ./...

vet: go.sum
	go vet ./...
[[ if eq .Target "local" ]]
MSG ?= hello

up: go.sum
	docker compose up --build -d

down:
	docker compose down -v

send:
	docker compose run --rm send "$(MSG)"

logs:
	docker compose logs -f worker
[[ else ]]
infra-init:
	terraform -chdir=infra init

infra-plan: infra-init
	terraform -chdir=infra plan

infra-apply: infra-init
	terraform -chdir=infra apply
[[ end ]]