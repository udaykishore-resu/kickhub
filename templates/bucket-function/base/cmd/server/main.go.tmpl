// Command server receives S3-format notifications over HTTP. MinIO posts to
// it locally; it is also handy for replaying a captured event with curl.
package main

import (
	"io"
	"log/slog"
	"net/http"
	"os"
	"time"

	"[[.P.go_module]]/internal/handler"
)

func main() {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /healthz", func(w http.ResponseWriter, _ *http.Request) { w.Write([]byte("ok")) })
	mux.HandleFunc("POST /events", func(w http.ResponseWriter, r *http.Request) {
		body, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 1<<20))
		if err != nil {
			http.Error(w, "body too large", http.StatusRequestEntityTooLarge)
			return
		}
		if err := handler.ProcessS3JSON(r.Context(), body); err != nil {
			slog.Error("event failed", "err", err)
			http.Error(w, "failed", http.StatusInternalServerError) // sender retries
			return
		}
		w.WriteHeader(http.StatusNoContent)
	})

	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}
	srv := &http.Server{Addr: ":" + port, Handler: mux, ReadHeaderTimeout: 5 * time.Second}
	slog.Info("[[.Name]] listening", "port", port)
	if err := srv.ListenAndServe(); err != nil {
		slog.Error("server failed", "err", err)
		os.Exit(1)
	}
}
