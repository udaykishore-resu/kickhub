.PHONY: tidy test vet[[ if eq .Target "local" ]] up down upload logs[[ else ]] infra-init infra-plan infra-apply[[ end ]][[ if eq .Target "aws" ]] package[[ end ]]

go.sum: go.mod
	go mod tidy

tidy:
	go mod tidy

test: go.sum
	go test ./...

vet: go.sum
	go vet ./...
[[ if eq .Target "local" ]]
up: go.sum
	docker compose up --build -d

down:
	docker compose down -v

upload:
	docker compose run --rm upload

logs:
	docker compose logs -f handler
[[ else ]]
infra-init:
	terraform -chdir=infra init
[[ if eq .Target "aws" ]]
package: go.sum
	mkdir -p build
	GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build -tags lambda.norpc -trimpath -o build/bootstrap ./cmd/lambda
	cd build && zip -q -j function.zip bootstrap

infra-plan: infra-init package
	terraform -chdir=infra plan

infra-apply: infra-init package
	terraform -chdir=infra apply
[[ else ]]
infra-plan: infra-init go.sum
	terraform -chdir=infra plan

infra-apply: infra-init go.sum
	terraform -chdir=infra apply
[[ end ]][[ end ]]