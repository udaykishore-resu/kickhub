# Local PostgreSQL. Data survives `make down`; remove the volume to reset it.
services:
  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: localsecret
      POSTGRES_DB: [[snake .Name]]
    ports:
      - "5432:5432"
    volumes:
      - data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d [[snake .Name]]"]
      interval: 5s
      timeout: 3s
      retries: 10

volumes:
  data:
