terraform {
  required_version = ">= 1.6"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
}

provider "google" {
  project = var.project
  region  = var.region
}

variable "name" {
  type    = string
  default = "[[.Name]]"
}

variable "project" {
  type    = string
  default = "[[.P.gcp_project]]"
}

variable "region" {
  type    = string
  default = "[[.P.gcp_region]]"
}
