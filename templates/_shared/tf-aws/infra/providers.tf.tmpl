terraform {
  required_version = ">= 1.6"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.region
  default_tags {
    tags = { component = var.name, managed_by = "terraform", created_with = "kickhub" }
  }
}

variable "name" {
  type    = string
  default = "[[.Name]]"
}

variable "region" {
  type    = string
  default = "[[.P.aws_region]]"
}
