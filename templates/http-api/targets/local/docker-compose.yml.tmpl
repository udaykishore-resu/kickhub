# Fully local stack: no cloud account, no credentials.
# The app runs the same DynamoDB adapter it uses on AWS, pointed at DynamoDB Local.
x-aws-env: &aws-env
  AWS_REGION: [[.P.aws_region]]
  AWS_ACCESS_KEY_ID: local
  AWS_SECRET_ACCESS_KEY: local

services:
  dynamodb:
    image: amazon/dynamodb-local:latest
    command: ["-jar", "DynamoDBLocal.jar", "-sharedDb", "-inMemory"]
    ports:
      - "8000:8000"

  init:
    image: amazon/aws-cli:latest
    depends_on:
      - dynamodb
    environment: *aws-env
    entrypoint: ["sh", "-c"]
    command:
      - >
        until aws dynamodb list-tables --endpoint-url http://dynamodb:8000 >/dev/null 2>&1; do sleep 1; done;
        aws dynamodb create-table --endpoint-url http://dynamodb:8000
        --table-name [[.Name]]-items
        --attribute-definitions AttributeName=id,AttributeType=S
        --key-schema AttributeName=id,KeyType=HASH
        --billing-mode PAY_PER_REQUEST

  app:
    build: .
    depends_on:
      init:
        condition: service_completed_successfully
    environment:
      <<: *aws-env
      AWS_ENDPOINT_URL: http://dynamodb:8000
      TABLE_NAME: [[.Name]]-items
    ports:
      - "8080:8080"
